{
  "name": "taylr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests panel.html playwright.config.ts",
    "browser:session": "node scripts/browser-session.mjs",
    "test:live": "TAYLR_LIVE_SITES=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.24",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
